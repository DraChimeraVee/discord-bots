# GenaWimsy's settings (an empty one stops it, naming the key):
#   install -d -m 700 ~/.config/genawimsy
#   install -m 600 genawimsy.env.example ~/.config/genawimsy/genawimsy.env     then fill it in
# GENAWIMSY_TOKEN     the bot's token (Developer Portal, Bot, Reset Token)
# GENAWIMSY_OWNER     the owner's user id, who approves every post (Developer Mode, Copy User ID)
# GENAWIMSY_USERS     id,id: whose messages reach the session; the owner's always do
GENAWIMSY_TOKEN=
GENAWIMSY_OWNER=
GENAWIMSY_USERS=
# Optional: where it reads and posts, their threads counting as them. Without the line, every channel and thread
# Discord lets the bot see.
# GENAWIMSY_CHANNELS=id,id
